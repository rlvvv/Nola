{
  "expo": {
    "name": "Nola",
    "slug": "nola",
    "scheme": "nola",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B0C",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nola.app"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
